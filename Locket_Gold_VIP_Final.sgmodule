#!name=Locket Gold VIP [CAT Final]
#!desc=Mở khóa toàn bộ tính năng Locket Gold, YouTube, Spotify. Chạy mượt, không giới hạn.
#!author=CAT (OMEGA)
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/TestFlight.png
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP
DOMAIN,firestore.googleapis.com,DIRECT
DOMAIN-SUFFIX,firebaseio.com,DIRECT
DOMAIN-SUFFIX,firebasedatabase.app,DIRECT
DOMAIN,us-central1-locket-4252a.cloudfunctions.net,DIRECT
DOMAIN,www.googleapis.com,DIRECT
DOMAIN,oauth2.googleapis.com,DIRECT
DOMAIN,people.googleapis.com,DIRECT
DOMAIN,firebasestorage.googleapis.com,DIRECT
DOMAIN-SUFFIX,firebasestorage.app,DIRECT
DOMAIN,storage.googleapis.com,DIRECT
DOMAIN-SUFFIX,appspot.com,DIRECT
DOMAIN,firebaseinstallations.googleapis.com,DIRECT
DOMAIN,identitytoolkit.googleapis.com,DIRECT
DOMAIN,securetoken.googleapis.com,DIRECT
DOMAIN,api.spotify.com,DIRECT
DOMAIN,open.spotify.com,DIRECT
DOMAIN,accounts.spotify.com,DIRECT
DOMAIN-SUFFIX,scdn.co,DIRECT
DOMAIN-SUFFIX,spotifycdn.com,DIRECT
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,spclient.wg.spotify.com),(PROTOCOL,UDP)),REJECT
DOMAIN,buy.itunes.apple.com,DIRECT
DOMAIN,play.google.com,DIRECT
DOMAIN,api.locketcamera.com,DIRECT
DOMAIN,api.revenuecat.com,DIRECT
DOMAIN,firebaseremoteconfig.googleapis.com,DIRECT
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,ingest.sentry.io,REJECT

[URL Rewrite]
^https?:\/\/locket-pro-backend\.onrender\.com\/(?:assets\/widget_frames|assets\/frames|uploads\/frames)\/(.+?)(?:_system(?:Small|Medium|Large|ExtraLarge)(?:@[0-9]x)?|@[0-9]x)\.png(\?.*)?$ https://locket-pro-backend.onrender.com/assets/frames/$1.png$2 302
^https?:\/\/i\.ibb\.co\/(.+?)(?:_system(?:Small|Medium|Large|ExtraLarge)(?:@[0-9]x)?|@[0-9]x)\.png(\?.*)?$ https://i.ibb.co/$1.png$2 302

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del If-None-Match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-modified-since
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del If-Modified-Since

^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del x-goog-if-none-match

^https?:\/\/api\.locketcamera\.com\/(getAccountInfo|getMomentViews|fetchMomentViews|getMomentViewers|getMomentActivity|getLatestMomentV2|getMoments|fetchMoments) header-del if-none-match
^https?:\/\/api\.locketcamera\.com\/(getAccountInfo|getMomentViews|fetchMomentViews|getMomentViewers|getMomentActivity|getLatestMomentV2|getMoments|fetchMoments) header-del If-None-Match
^https?:\/\/api\.locketcamera\.com\/(getAccountInfo|getMomentViews|fetchMomentViews|getMomentViewers|getMomentActivity|getLatestMomentV2|getMoments|fetchMoments) header-del if-modified-since
^https?:\/\/api\.locketcamera\.com\/(getAccountInfo|getMomentViews|fetchMomentViews|getMomentViewers|getMomentActivity|getLatestMomentV2|getMoments|fetchMoments) header-del If-Modified-Since

^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)\/(user-customization-service\/v1\/customize|bootstrap\/v1\/bootstrap) header-del if-none-match
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)\/(user-customization-service\/v1\/customize|bootstrap\/v1\/bootstrap) header-del If-None-Match
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)\/(user-customization-service\/v1\/customize|bootstrap\/v1\/bootstrap) header-del if-modified-since
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)\/(user-customization-service\/v1\/customize|bootstrap\/v1\/bootstrap) header-del If-Modified-Since

[Script]
# BẠN THAY LINK RAW CỦA BẠN VÀO ĐÂY
locket_rc = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/khoitran1328/test5/refs/heads/main/locket.js
locket_fb = type=http-response,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/khoitran1328/test5/refs/heads/main/locket.js
youtube_response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/khoitran1328/test5/refs/heads/main/locket.js
spotify_json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/khoitran1328/test5/refs/heads/main/locket.js
spotify_proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize),requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/khoitran1328/test5/refs/heads/main/locket.js

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[MITM]
hostname = %APPEND% -firebasestorage.googleapis.com, -*.firebasestorage.app, -storage.googleapis.com, -*.appspot.com, -firebaseinstallations.googleapis.com, -identitytoolkit.googleapis.com, -securetoken.googleapis.com, -firestore.googleapis.com, -*.firebaseio.com, -*.firebasedatabase.app, -www.googleapis.com, -oauth2.googleapis.com, -people.googleapis.com, -api.spotify.com, -open.spotify.com, -accounts.spotify.com, -*.scdn.co, *.googlevideo.com, youtubei.googleapis.com, api.revenuecat.com, firebaseremoteconfig.googleapis.com, spclient.wg.spotify.com, *spclient.spotify.com, api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net, locket-pro-backend.onrender.com, i.ibb.co
